{
  "name": "hello-devops",
  "version": "0.1.0",
  "private": true,
  "description": "Small REST API (Node.js + Express) demonstrating production-style cloud-native deployment.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
