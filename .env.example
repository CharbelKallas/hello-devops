# Copy to `.env` for local development — `.env` is gitignored.
# NEVER commit real credentials.

# Loaded by `npm start`, `npm run dev` and `npm run test:integration` through
# Node's --env-file-if-exists.
# The defaults below match compose.yaml (`npm run db:up`).

# --- Application ---
PORT=3000
# VERSION=0.1.0            # optional override; defaults to package.json

# Optional shared secret (min. 16 characters). When set, /users,
# /documents and /cache require `Authorization: Bearer <API_KEY>`.
# Generate one with: openssl rand -hex 32
API_KEY=

# --- PostgreSQL (relational data: users) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=lab
PGUSER=postgres
PGPASSWORD=                # empty is fine for `trust` authentication

# --- MongoDB (document data: documents) ---
MONGODB_URI=mongodb://localhost:27017/hello-devops

# --- Redis (cache: /cache endpoints) ---
REDIS_HOST=localhost
REDIS_PORT=6379
