# Copy to `.env` for local development — `.env` is gitignored.
# NEVER commit real credentials.

# --- Application ---
PORT=3000
# VERSION=0.1.0            # optional override; defaults to package.json

# --- PostgreSQL (relational data: users) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=lab
PGUSER=postgres
PGPASSWORD=                # empty is fine for `trust` authentication

# --- MongoDB (document data: documents) ---
MONGODB_URI=mongodb://localhost:27017/hello-devops

# --- Redis (cache: /cache endpoints) ---
REDIS_HOST=localhost
REDIS_PORT=6379
